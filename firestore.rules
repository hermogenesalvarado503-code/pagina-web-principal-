// Firestore Security Rules para DRHGA
// Estructura de datos esperada:
// users/{uid}
// messages/{messageId}
// reviews/{reviewId}
// gallery/{galleryId}
// events/{eventId}
// password_change_tokens/{tokenId}
// admin_access_logs/{logId}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Permitir lectura pública de ciertos datos
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /reviews/{document=**} {
      allow read: if resource.data.approved == true;
      allow write: if isAuthenticated();
      allow delete: if isAdmin() || isOwner();
    }
    
    // Mensajes: lectura pública, escritura autenticada
    match /messages/{document=**} {
      allow read: if isAdmin();
      allow create: if true; // Permitir enviar mensajes sin autenticación
      allow delete: if isAdmin();
    }
    
    // Usuarios: solo admin puede leer/escribir
    match /users/{uid} {
      allow read: if isAdmin() || uid == request.auth.uid;
      allow write: if isAdmin() || uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    // Tokens de cambio de contraseña: protegidos
    match /password_change_tokens/{tokenId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Logs de acceso admin: solo admin
    match /admin_access_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Historial de cambios de contraseña
    match /password_change_history/{historyId} {
      allow read: if isAdmin() || request.auth.uid == resource.data.user_id;
      allow write: if isAdmin() || isAuthenticated();
    }
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.user_id;
    }
  }
}
